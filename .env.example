# Supabase Configuration
# Configure these in your environment or dynamically in Admin -> Settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Single Admin Account (Required for Admin Access)
VITE_ADMIN_USER=your_admin_username
VITE_ADMIN_PASS=your_secure_password

# Multi-Admin Option A: User:Password pairs
# VITE_ADMIN_CREDS=admin1:secretPass1,manager:secretPass2

# Multi-Admin Option B: Comma-separated lists
# VITE_ADMIN_USERS=admin1,admin2
# VITE_ADMIN_PASSWORDS=pass1,pass2



