# Supabase Configuration
# You can also configure these dynamically inside Admin Control Tower -> Settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Single Admin Account
VITE_ADMIN_USER=lexicoadmin
VITE_ADMIN_PASS=laxico@4321

# Multi-Admin Option A: User-Password pairs (user1:pass1,user2:pass2,user3:pass3)
VITE_ADMIN_CREDS=dinesh:pass123,manager:pass456,superadmin:pass789

# Multi-Admin Option B: Comma-separated list
VITE_ADMIN_USERS=admin1,admin2,admin3
VITE_ADMIN_PASSWORDS=pass1,pass2,pass3


